PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="mysql://root:password@localhost:3306/whatslandlord_erp"
JWT_ACCESS_SECRET="your_access_token_secret_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_refresh_token_secret_key"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Authorize.Net Payment Gateway Config (Superadmin / Platform)
AUTHORIZE_NET_ENV=sandbox
AUTHORIZE_NET_API_LOGIN_ID=your_api_login_id
AUTHORIZE_NET_TRANSACTION_KEY=your_transaction_key
AUTHORIZE_NET_SIGNATURE_KEY=your_signature_key
AUTHORIZE_NET_CLIENT_KEY=your_public_client_key

# Integration Keys Encryption Key (AES-256 requires exactly 32 bytes)
INTEGRATION_ENCRYPTION_KEY="your_32_characters_secret_key"

# OpenAI Paid API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_ORG_ID=


